{
  "name": "Sumter Field Desk",
  "short_name": "Field Desk",
  "description": "Community research on the proposed Sumter County data center: an interactive site map, the research notes, and the neighbourhood message board.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
